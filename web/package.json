{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "doctor": "react-doctor . --verbose --diff",
    "e2e": "bun run verify:bun && bun run build && playwright test --grep-invert @finding",
    "lint": "oxlint --config ../oxlint.config.ts",
    "preview": "vite preview",
    "test": "bun test src",
    "verify:findings": "bun run verify:bun && bun run build && playwright test --grep @finding",
    "verify:keyboard": "bun run verify:bun && bun run build && playwright test keyboard-matrix --grep @guard",
    "verify:bun": "bun scripts/verify-bun-version.ts",
    "verify:gate": "bun run verify:bun && bun run build && playwright test --grep @guard"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons": "^5.15.0",
    "@shadcn/react": "^0.3.0",
    "better-result": "3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "thinking-orbs": "^0.3.1",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "1.78.0",
    "react-doctor": "0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
